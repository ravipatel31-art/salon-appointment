# Environment template for the root docker-compose stack (and Render env vars).
# Copy:  cp deploy/.env.example .env   then edit — NEVER commit a filled .env.

# --- Postgres (compose db service) ---------------------------------------
POSTGRES_USER=salon
# URL-safe password (letters/digits/_- only, or percent-encode for DATABASE_URL):
POSTGRES_PASSWORD=change-me-url-safe-pw
POSTGRES_DB=salon

# --- App ------------------------------------------------------------------
APP_NAME="Salon API"
ENVIRONMENT=production
API_PORT=8000

# JWT signing secret — generate one, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-long-random

# Seed admin (used by `python -m app.seed` on container start) ------------
ADMIN_PHONE=+911234567890
ADMIN_PASSWORD=change-me-admin
ADMIN_EMAIL=admin@salon.local

# --- Razorpay (Dashboard → API Keys; webhook secret under Webhooks) ------
# Leave empty + RAZORPAY_MOCK=1 for offline demos without an account.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MOCK=0

# --- Booking policy (defaults match AGENTS.md — usually untouched) -------
BOOKING_HOLD_MINUTES=12
CANCEL_REFUND_WINDOW_HOURS=2

# --- Hold-expiry background sweep (12-min unpaid holds) ------------------
HOLD_EXPIRY_WORKER=1
HOLD_EXPIRY_INTERVAL_SECONDS=30

# --- Flutter build-time defines (baked with --dart-define, not runtime) ---
# API_BASE_URL=https://api.yourdomain.com
# USE_MOCK_API=false
