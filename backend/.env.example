# Copy to .env for local development. Runtime always targets PostgreSQL.
DATABASE_URL=postgresql+psycopg://salon:salon@localhost:5432/salon
APP_NAME=Salon API
ENVIRONMENT=development

# Phase 1 seed admin (seed script) — fill when running seeds:
# ADMIN_PHONE=
# ADMIN_PASSWORD=

# JWT (phase 1+)
# JWT_SECRET=
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Booking policy (AGENTS.md constants)
# BOOKING_HOLD_MINUTES=12
# CANCEL_REFUND_WINDOW_HOURS=2
