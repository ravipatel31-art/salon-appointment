# Root ignores — secrets + local artifacts (never commit)

# Secrets / local env
.env
.env.*
!.env.example
!deploy/.env.example
**/.env.local

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# Node / tooling (opencode agent pack)
.opencode/node_modules/
*.log

# Flutter / mobile build output (large)
mobile/build/
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/**/ephemeral/
mobile/ios/Pods/
mobile/ios/.symlinks/
mobile/android/.gradle/

# IDE / OS
.idea/
.vscode/
.DS_Store
*.iml

# Local screenshots / temp
*.webm
/tmp/
